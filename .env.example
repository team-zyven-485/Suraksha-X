# ---------------------------------------------------------------------------
# SURAKSHA-X server configuration. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# MongoDB connection string (Atlas or local), e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
#   mongodb://127.0.0.1:27017
# Leave empty to run on the in-memory store (data is lost on restart; the
# dashboard shows "MEMORY MODE — NOT SAVED").
MONGODB_URI=
MONGODB_DB=suraksha_x

# Access codes for the privileged roles. Choose long random values.
# If left empty the server generates a temporary code and prints it at startup.
ADMIN_ACCESS_CODE=
RESCUE_ACCESS_CODE=

# Secret used to sign login sessions (32+ random characters).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: Gemini key for the AI copilot. Without it the chat answers from the
# built-in rule-based tactical engine (the chat header shows which one replied).
GEMINI_API_KEY=

# Set to 1 when deployed behind a reverse proxy (Render, Railway, Nginx…) so
# rate limits use each visitor's real IP.
TRUST_PROXY=

# Port for the Node server (default 3000).
PORT=3000

# Satellite Intelligence backend (FastAPI), optional. Local default shown.
VITE_API_BASE_URL=http://localhost:8000
