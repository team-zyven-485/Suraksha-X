# Copernicus Data Space Ecosystem credentials (OAuth2 client-credentials grant).
# Register a client at https://identity.dataspace.copernicus.eu/
# Leave blank to run the Satellite Intelligence module in DEMO DATA mode.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Supabase (service-role key — backend only, never exposed to the frontend).
# Get the service_role key from: Supabase Dashboard -> Project Settings ->
# API -> Project API keys -> service_role (NOT the anon/publishable key).
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# CORS: comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# If the latest available Sentinel-1 observation for an AOI is older than this,
# the API reports "NO RECENT OBSERVATION" instead of silently using stale data.
MAX_OBSERVATION_AGE_HOURS=72
